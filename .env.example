# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) from Dashboard → Settings → API Keys.
# Not the legacy anon JWT (eyJ...), which Supabase is retiring.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Google Maps API Keys
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GEOCODE_API_KEY=your-geocoding-api-key

# Cloudflare Turnstile (for bot protection)
VITE_CAPTCHA_SITE_KEY=your-turnstile-site-key

# Admin scripts in scripts/ only (never prefix with VITE_, which would ship it to the browser)
# SUPABASE_SECRET_KEY=sb_secret_your-key-here
